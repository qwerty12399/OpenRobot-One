<?xml version="1.0"?>
<sdf version="1.6">
  <world name="office_test">
    <gravity>0 0 -9.8</gravity>
    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000.0</real_time_update_rate>
    </physics>

    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.75 0.8 0.85 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>8 6</size></plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane><normal>0 0 1</normal><size>8 6</size></plane>
          </geometry>
          <material>
            <ambient>0.75 0.75 0.72 1</ambient>
            <diffuse>0.75 0.75 0.72 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_north">
      <static>true</static>
      <pose>0 3 1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>8 0.1 2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>8 0.1 2</size></box></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient></material>
        </visual>
      </link>
    </model>

    <model name="wall_south">
      <static>true</static>
      <pose>0 -3 1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>8 0.1 2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>8 0.1 2</size></box></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient></material>
        </visual>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static>
      <pose>-4 0 1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.1 6 2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 6 2</size></box></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient></material>
        </visual>
      </link>
    </model>

    <model name="wall_east">
      <static>true</static>
      <pose>4 0 1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.1 6 2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 6 2</size></box></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient></material>
        </visual>
      </link>
    </model>

    <!-- Two wall pairs form north/south rooms and leave 0.85 m doors. -->
    <model name="north_room_wall_west">
      <static>true</static>
      <pose>-2.2125 1.0 1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>3.575 0.1 2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>3.575 0.1 2</size></box></geometry>
          <material><ambient>0.72 0.78 0.84 1</ambient></material>
        </visual>
      </link>
    </model>

    <model name="north_room_wall_east">
      <static>true</static>
      <pose>2.2125 1.0 1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>3.575 0.1 2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>3.575 0.1 2</size></box></geometry>
          <material><ambient>0.72 0.78 0.84 1</ambient></material>
        </visual>
      </link>
    </model>

    <model name="south_room_wall_west">
      <static>true</static>
      <pose>-2.2125 -1.0 1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>3.575 0.1 2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>3.575 0.1 2</size></box></geometry>
          <material><ambient>0.72 0.78 0.84 1</ambient></material>
        </visual>
      </link>
    </model>

    <model name="south_room_wall_east">
      <static>true</static>
      <pose>2.2125 -1.0 1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>3.575 0.1 2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>3.575 0.1 2</size></box></geometry>
          <material><ambient>0.72 0.78 0.84 1</ambient></material>
        </visual>
      </link>
    </model>

    <!-- Parallel walls leave a measured 0.85 m clear narrow passage. -->
    <model name="narrow_passage_north">
      <static>true</static>
      <pose>3.0 0.475 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.2 0.1 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.2 0.1 1.0</size></box></geometry>
          <material><ambient>0.65 0.72 0.8 1</ambient></material>
        </visual>
      </link>
    </model>

    <model name="narrow_passage_south">
      <static>true</static>
      <pose>3.0 -0.475 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.2 0.1 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.2 0.1 1.0</size></box></geometry>
          <material><ambient>0.65 0.72 0.8 1</ambient></material>
        </visual>
      </link>
    </model>

    <model name="obstacle_1">
      <static>true</static>
      <pose>-2.5 2.0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.5 0.5 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.5 0.5 0.5</size></box></geometry>
          <material><ambient>0.65 0.35 0.2 1</ambient></material>
        </visual>
      </link>
    </model>

    <model name="obstacle_2">
      <static>true</static>
      <pose>1.8 2.1 0.2 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.4 0.6 0.4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.4 0.6 0.4</size></box></geometry>
          <material><ambient>0.65 0.35 0.2 1</ambient></material>
        </visual>
      </link>
    </model>

    <model name="obstacle_3">
      <static>true</static>
      <pose>-1.8 -2.0 0.3 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.6 0.4 0.6</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.6 0.4 0.6</size></box></geometry>
          <material><ambient>0.65 0.35 0.2 1</ambient></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
